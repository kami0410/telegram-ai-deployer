{
  "name": "persona-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backup": "node tools/persona-backup.selftest.mjs",
    "backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/persona-backup.ps1 -Mode backup",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types --env-file config/type-bindings.env --strict-vars false",
    "check": "npm run cf:types -- --check && npm run typecheck && npm test && npm run test:backup",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --minify"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260724.1",
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
