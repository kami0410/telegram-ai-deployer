{
  "name": "cloudflare-telegram-ai-bot-deployer",
  "version": "0.1.1",
  "description": "Privacy-focused Windows deployment wizard for a Cloudflare Telegram AI bot.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Open Source Maintainers",
  "engines": {
    "node": ">=22"
  },
  "main": "app/main.mjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "privacy:scan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/privacy-scan.ps1",
    "start": "electron .",
    "package": "electron-builder --dir",
    "make": "electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.opensource.cloudflare-telegram-ai-bot-deployer",
    "productName": "Cloudflare Telegram AI Bot Deployer",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "app/**/*",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "template",
        "to": "template"
      },
      {
        "from": "DISCLAIMER.md",
        "to": "DISCLAIMER.md"
      },
      {
        "from": "DISCLAIMER_ZH.md",
        "to": "DISCLAIMER_ZH.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Telegram.AI.Deployer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "wrangler": "4.114.0"
  }
}
